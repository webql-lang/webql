{application, webql, [
    {vsn, "0.1.0-alpha.2"},
    {applications, [gleam_stdlib]},
    {description, "A typed query language and runtime for building executable data graphs."},
    {modules, [basic_ffi,
               webql,
               webql@@main,
               webql@assembler,
               webql@assembler@diagnostic,
               webql@assembler@linker,
               webql@assembler@linker@diagnostic,
               webql@assembler@linker@link_node,
               webql@assembler@linker@link_program,
               webql@assembler@linker@link_route,
               webql@assembler@linker@program,
               webql@assembler@plan,
               webql@assembler@scheduler,
               webql@assembler@scheduler@diagnostic,
               webql@assembler@scheduler@schedule_plan,
               webql@assembler@scheduler@schedule_route,
               webql@assembler@scheduler@topology,
               webql@compiler,
               webql@compiler@context,
               webql@compiler@diagnostic,
               webql@compiler@environment,
               webql@compiler@lexer,
               webql@compiler@lexer@diagnostic,
               webql@compiler@lexer@lex_comment,
               webql@compiler@lexer@lex_lower_identifier,
               webql@compiler@lexer@lex_number,
               webql@compiler@lexer@lex_string,
               webql@compiler@lexer@lex_upper_identifier,
               webql@compiler@lexer@lex_whitespace,
               webql@compiler@lexer@token,
               webql@compiler@lowerer,
               webql@compiler@lowerer@lower_document,
               webql@compiler@lowerer@lower_edge,
               webql@compiler@lowerer@lower_graph,
               webql@compiler@lowerer@lower_node,
               webql@compiler@lowerer@lower_parameter,
               webql@compiler@lowerer@lower_return,
               webql@compiler@lowerer@lower_source,
               webql@compiler@lowerer@lower_target,
               webql@compiler@lowerer@lower_value,
               webql@compiler@parser,
               webql@compiler@parser@ast,
               webql@compiler@parser@diagnostic,
               webql@compiler@parser@parse_document,
               webql@compiler@parser@parse_edge,
               webql@compiler@parser@parse_graph,
               webql@compiler@parser@parse_node,
               webql@compiler@parser@parse_nonstarter,
               webql@compiler@parser@parse_parameter,
               webql@compiler@parser@parse_port,
               webql@compiler@parser@parse_return,
               webql@compiler@parser@parse_source,
               webql@compiler@parser@parse_supernode,
               webql@compiler@parser@parse_target,
               webql@compiler@parser@parse_value,
               webql@compiler@reference,
               webql@compiler@resolver,
               webql@compiler@resolver@diagnostic,
               webql@compiler@resolver@hir,
               webql@compiler@resolver@register_edge,
               webql@compiler@resolver@register_node,
               webql@compiler@resolver@register_parameter,
               webql@compiler@resolver@register_return,
               webql@compiler@resolver@register_supernode,
               webql@compiler@resolver@resolve_document,
               webql@compiler@resolver@resolve_edge,
               webql@compiler@resolver@resolve_graph,
               webql@compiler@resolver@resolve_node,
               webql@compiler@resolver@resolve_parameter,
               webql@compiler@resolver@resolve_port,
               webql@compiler@resolver@resolve_return,
               webql@compiler@resolver@resolve_source,
               webql@compiler@resolver@resolve_target,
               webql@compiler@resolver@resolve_value,
               webql@compiler@source,
               webql@compiler@typechecker,
               webql@compiler@typechecker@diagnostic,
               webql@compiler@typechecker@typecheck_document,
               webql@compiler@typechecker@typecheck_edge,
               webql@diagnostic,
               webql@engine,
               webql@engine@basic,
               webql@graph,
               webql@introspection,
               webql@memory,
               webql@runner,
               webql@runner@diagnostic,
               webql@runner@run,
               webql@runner@run_batch,
               webql@runner@run_plan,
               webql@runner@run_step,
               webql@schema]},
    {registered, []}
]}.
