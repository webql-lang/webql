/// A stable binding reference.
pub type Binding {
  Binding(Int)
}

/// A input reference path.
pub type Input {
  Input(Int)
}

/// A reference to a stable module.
pub type Module {
  Module(Int)
}

/// A reference to a stable node.
pub type Node {
  Node(Int)
}

/// A output reference path.
pub type Output {
  Output(Int)
}

/// A stable operation reference.
pub type Operation {
  Operation(Int)
}

/// A reference to a stable type in an operation.
pub type Typename {
  Typename(Int)
}
