default:
    @just --list --unsorted

deps:
    gleam deps download

test *args:
    @if [ -z "{{ args }}" ]; then gleam test --target erlang && gleam test --target javascript; else gleam test {{ args }}; fi

compile *args:
    @if [ -z "{{ args }}" ]; then gleam build --target erlang; else gleam build {{ args }}; fi

format:
    gleam format src test

format-check:
    gleam format --check src test
